{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "rootDir": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "strict": false,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": true,
    "types": []
  },
  "include": ["index.ts", "src/**/*.ts", "config/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}

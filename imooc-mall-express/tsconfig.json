{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "sourceMap": true
  },
  "include": ["app.ts", "bin/**/*.ts", "db/**/*.ts", "models/**/*.ts", "routes/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}

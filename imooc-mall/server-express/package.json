    "morgan": "~1.9.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "c8": "^12.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
